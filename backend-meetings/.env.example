# Copy to .env and fill in. Never commit .env.

DJANGO_DEBUG=False
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# the company database: the same values as backend/.env
DB_NAME=genmars_tech_db
DB_USER=genmars_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# email for task notifications (optional; printed to the logs when empty)
RESEND_EMAIL_API_KEY=
EMAIL=info@genmars.co.ke

# Google Meet + Calendar, from the OAuth "Web application" client in Google Cloud.
# Add GOOGLE_REDIRECT_URI to that client's "Authorized redirect URIs" exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.genmars.co.ke/api/v1/integrations/google/callback/
# optional: Fernet key for the stored Google tokens (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
GOOGLE_TOKEN_KEY=

# docker compose (optional overrides; defaults shown)
MEETINGS_API_PORT=8001
MEETINGS_URL=https://meetings.genmars.co.ke
SITE_ORIGINS=https://meetings.genmars.co.ke
