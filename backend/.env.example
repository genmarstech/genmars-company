# Copy to .env and fill in. Never commit .env.

# django
DJANGO_DEBUG=False
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# database (also used by docker-compose.yml)
DB_NAME=genmars_tech_db
DB_USER=genmars_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# email (leave EMAIL_HOST empty to print emails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Genmars Tech <info@genmars.co.ke>
ENQUIRY_NOTIFY_EMAIL=info@genmars.co.ke
