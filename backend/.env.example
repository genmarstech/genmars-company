# Copy to .env and fill in. Never commit .env.

# django
DJANGO_DEBUG=False
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# database (also used by docker-compose.yml)
DB_NAME=genmars_tech_db
DB_USER=genmars_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# email: set RESEND_EMAIL_API_KEY to send through Resend, or EMAIL_HOST for another
# SMTP server; leave both empty to print emails to the console
RESEND_EMAIL_API_KEY=
EMAIL=info@genmars.co.ke
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Genmars Tech <info@genmars.co.ke>
ENQUIRY_NOTIFY_EMAIL=info@genmars.co.ke

# docker compose (optional overrides; defaults shown)
API_PORT=8000
API_HOSTS=api.genmars.co.ke,localhost,127.0.0.1
API_ORIGINS=https://api.genmars.co.ke
SITE_ORIGINS=https://company-v1-gamma.vercel.app,https://genmars.co.ke,https://www.genmars.co.ke
FRONTEND_URL=https://company-v1-gamma.vercel.app

# Sign in with Google: the "Genmars Tech" OAuth client in Google Cloud (never commit the secret)
GOOGLE_CLIENT_ID=160878880102-o6hg2vjr1nru55echn3lu0qbdg0ndboc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=https://api.genmars.co.ke/api/v1/auth/google/callback/
